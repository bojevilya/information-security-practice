# Скопіюйте у .env і заповніть:
#   JWT_SECRET_KEY     — openssl rand -hex 32
#   ENCRYPTION_KEY     — python -m scripts.generate_key (Fernet, urlsafe-base64)
#   BLIND_INDEX_KEY    — python -m scripts.generate_key (64 hex-символи)
JWT_SECRET_KEY=
ENCRYPTION_KEY=
BLIND_INDEX_KEY=
